{
  "name": "ai-coding-sessions",
  "version": "0.1.0",
  "type": "module",
  "description": "Multi-source AI coding session list/detail + SQLite cache",
  "license": "MIT",
  "author": "waterwu <boatwind@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watert/ai-coding-sessions.git"
  },
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./pricing": "./src/pricing.ts"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "core.ts",
    "!**/*.test.ts"
  ],
  "typesVersions": {
    "*": {
      "core": ["src/core/index.ts", "core.ts"],
      "pricing": ["src/pricing.ts"],
      "*": ["src/*"]
    }
  },
  "scripts": {
    "check": "bunx tsc --noEmit --project tsconfig.json",
    "test": "bun test src"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "debug": "^4.4.3",
    "diff": "^8.0.4",
    "lodash": "^4.17.21",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.8.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/debug": "^4.1.12",
    "@types/lodash": "^4.17.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
